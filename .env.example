# NEXUSFLOW-ENGINE — names only. Never commit real secrets.
# Paper-trading matcher. Direct PostgreSQL connection. Not a frontend variable.

NODE_ENV=development
PORT=8080
DATABASE_URL=
DATABASE_SSL=
AUTO_MIGRATE=

# HMAC (local/test) or Supabase Auth (production project, after it is confirmed)
NEXUSFLOW_AUTH_MODE=
NEXUSFLOW_JWT_SECRET=
SUPABASE_JWT_SECRET=
SUPABASE_URL=
JWT_ISSUER=
JWT_AUDIENCE=

MATCHER_LOCK_KEY=nexusflow:global-matcher
MATCHER_INSTANCE_ID=
COMMAND_POLL_INTERVAL_MS=50
COMMAND_WAIT_MS=2000
MAX_COMMAND_QUEUE_DEPTH=1000
COMMAND_LEASE_MS=30000
MAX_BODY_BYTES=16384
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SEC=10
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
LOCK_HEARTBEAT_MS=2000
SHUTDOWN_DRAIN_MS=5000
PG_POOL_MAX=8
STATEMENT_TIMEOUT_MS=10000
QUERY_TIMEOUT_MS=10000
CONNECTION_TIMEOUT_MS=3000
LOG_LEVEL=info

# Optional, unused by the matcher process
NEXUSFLOW_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_API_BASE=
